<data>
  <xpath expr="//div[@id='introduction']" position="before">
    <div t-if="(sale_order.state in ['draft','sent'] or ('x_mnl_frozen' in sale_order._fields and sale_order.x_mnl_frozen))" class="mnl_portal_preview">
      <style>
        .mnl_portal_preview { padding:16px; background:white; border:1px solid #dbe6eb; border-radius:8px; }
        .mnl_portal_preview .mnl-offer { font-size:12px; }
        .mnl_portal_preview .mnl-lines-scroll { overflow-x:auto; }
        .mnl_portal_preview .mnl-offer .lines { min-width:1000px; font-size:11px; }
        .mnl_portal_preview .mnl-offer .lines th { padding:8px 4px; overflow-wrap:anywhere; border-right:1px solid #487283; }
        .mnl_portal_preview .footer { position:static; margin-top:20px; }
        .mnl_portal_preview .footer > span:last-child { display:none; }
        .mnl_portal_preview .mnl-dimension-warning { margin:0; }
      </style>
      <t t-set="doc" t-value="sale_order.with_context(mnl_portal_preview=True)"/>
      <t t-call="mnl_solutions.report_quotation_standard_document"/>
    </div>
  </xpath>
  <xpath expr="//div[@id='introduction']" position="attributes">
    <attribute name="t-if">sale_order.state not in ['draft','sent'] and not ('x_mnl_frozen' in sale_order._fields and sale_order.x_mnl_frozen)</attribute>
  </xpath>
  <xpath expr="//div[@id='content']" position="attributes">
    <attribute name="t-if">sale_order.state not in ['draft','sent'] and not ('x_mnl_frozen' in sale_order._fields and sale_order.x_mnl_frozen)</attribute>
  </xpath>
</data>
